<Bindings>
	<!-- category: own row under Keybindings (trailing space = safe custom section name on retail) -->
	<!-- Namespaced name: BINDING_NAME_* globals are shared across all addons, so a
	     generic "TOGGLEMAIN" can collide with other addons' binding labels. -->
	<Binding name="MIDNIGHTHELPER_TOGGLEMAIN" category="Midnight Helper " runOnUp="false" default="ALT-M">
		MidnightHelper_KeybindToggleMain()
	</Binding>
	<Binding name="MIDNIGHTHELPER_SKIPNODE" category="Midnight Helper " runOnUp="false">
		MidnightHelper_KeybindSkipNode()
	</Binding>
	<Binding name="MIDNIGHTHELPER_CLEARROUTE" category="Midnight Helper " runOnUp="false">
		MidnightHelper_KeybindClearRoute()
	</Binding>
</Bindings>
