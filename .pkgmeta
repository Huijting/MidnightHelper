# BigWigs packager config — auto-publishes to CurseForge on a git tag
# (see .github/workflows/release.yml). Mirrors the exclusions from tools/package.ps1
# so the auto-built zip matches the manual one; the zip root folder is MidnightHelper/.

package-as: MidnightHelper

# We ship a hand-maintained .toc and use no embedded libraries' nolib stripping.
enable-toc-creation: no
enable-nolib-creation: no

# Hand-written CurseForge release notes instead of an auto-generated dump of every
# commit. (The first-ever tag v2.5.0 had no previous tag to bound against, so the
# packager pulled the entire history.)
#
# The packager uploads this file VERBATIM, so it must hold only the CURRENT release.
# Pointing it at CHANGELOG.md would paste all 700+ lines of history onto every
# release page. Overwrite RELEASE_NOTES.md on each version bump; the full history
# stays in CHANGELOG.md and a per-version archive in docs/CURSEFORGE_<version>.md.
#
# MARKDOWN, not HTML — and NO HTML AT ALL, not even a comment.
# RELEASE_NOTES.md must start with a plain Markdown heading and contain no HTML.
# History: 2.6.0 rendered clean (file began with "# Midnight Helper 2.6.0"). 2.7.0
# shipped real HTML and CF flattened it. The "fix" then added a maintainer note as an
# <!-- HTML comment --> at the top of the file, believing the renderer would hide it —
# and 2.8.0 came out escaped again ("\\## Know your role", "\\*\\*doing your job"), with
# the newlines collapsed. The leading HTML comment is what trips it. Keep this file pure
# Markdown; maintainer instructions live here and in CLAUDE.md, never in the uploaded file.
# If a release still looks wrong, hand-fix on curseforge.com: open the file's Changelog,
# Markdown mode, paste RELEASE_NOTES.md's body, Save.
manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown

# Everything below is kept OUT of the release zip (dev tooling, docs, build scripts,
# internal notes). .git is excluded automatically. CLAUDE.md stays out — it must never
# ship (review F5.2 / P0).
ignore:
  - .github
  - tools
  - docs
  # The public web page (GitHub Pages). Belongs on the internet, not in a player's
  # AddOns folder -- it would be dead weight in every download.
  - site
  - data
  - dist
  - .cursor
  - .cursorrules
  - .gitattributes
  - .gitignore
  - .pkgmeta
  - .luarc.json
  - CLAUDE.md
  - README.md
  - CHANGELOG.md
  - RELEASE_NOTES.md
  - RELEASE_CHECKLIST.md
  - CURSEFORGE_DESCRIPTION.md
  - "*.bat"
  - "*.cmd"
  - "*.ps1"
  - "*.py"
  # Knowledge sources are YAML/JSON under docs/, which is already ignored above. These two
  # lines are a backstop for the day someone drops a knowledge object outside docs/ — the
  # upstream source must never ship, only the transpiled Lua does.
  - "*.yaml"
  - "*.yml"
  - "*.exe"
  - "*.vbs"
