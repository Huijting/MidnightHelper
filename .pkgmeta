# BigWigs packager config — auto-publishes to CurseForge on a git tag
# (see .github/workflows/release.yml). Mirrors the exclusions from tools/package.ps1
# so the auto-built zip matches the manual one; the zip root folder is MidnightHelper/.

package-as: MidnightHelper

# We ship a hand-maintained .toc and use no embedded libraries' nolib stripping.
enable-toc-creation: no
enable-nolib-creation: no

# Hand-written CurseForge release notes instead of an auto-generated dump of every
# commit. (The first-ever tag v2.5.0 had no previous tag to bound against, so the
# packager pulled the entire history.)
#
# The packager uploads this file VERBATIM, so it must hold only the CURRENT release.
# Pointing it at CHANGELOG.md would paste all 700+ lines of history onto every
# release page. Overwrite RELEASE_NOTES.md on each version bump; the full history
# stays in CHANGELOG.md and a per-version archive in docs/CURSEFORGE_<version>.md.
#
# MARKDOWN, not HTML: CurseForge's changelog field renders Markdown. 2.6.0 shipped
# Markdown with this exact config and rendered clean. 2.7.0 briefly shipped HTML
# (commit f62a445, now reverted) and the packager/CF flattened it into raw run-on
# "##"/"**" text — that was the regression, NOT a Markdown problem. Keep markup-type
# markdown + RELEASE_NOTES.md. Any maintainer note in the file must be an <!-- HTML
# comment --> (hidden by the Markdown renderer). If a release still looks wrong, hand-fix
# on curseforge.com: open the file's Changelog, Markdown mode, paste this file's body.
manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown

# Everything below is kept OUT of the release zip (dev tooling, docs, build scripts,
# internal notes). .git is excluded automatically. CLAUDE.md stays out — it must never
# ship (review F5.2 / P0).
ignore:
  - .github
  - tools
  - docs
  - data
  - dist
  - .cursor
  - .cursorrules
  - .gitattributes
  - .gitignore
  - .pkgmeta
  - .luarc.json
  - CLAUDE.md
  - README.md
  - CHANGELOG.md
  - RELEASE_NOTES.md
  - RELEASE_CHECKLIST.md
  - CURSEFORGE_DESCRIPTION.md
  - "*.bat"
  - "*.cmd"
  - "*.ps1"
  - "*.py"
  - "*.exe"
  - "*.vbs"
